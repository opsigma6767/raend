local flyEnabled = false
local flySpeed = 50
local flyKeybind = Enum.KeyCode.F
local listeningKey = nil

-- UI Helper Component Generators
local function createSectionTitle(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = string.upper(text)
    label.TextColor3 = Color3.fromRGB(110, 115, 135)
    label.TextSize = 10
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = Container
end

local function createButton(text, bgCol)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = bgCol or Color3.fromRGB(30, 30, 38)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(230, 230, 240)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.AutoButtonColor = true
    btn.Parent = Container
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

local function createInput(placeholder)
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(1, 0, 0, 32)
    input.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    input.Text = placeholder
    input.TextColor3 = Color3.fromRGB(200, 200, 215)
    input.Font = Enum.Font.Gotham
    input.TextSize = 12
    input.Parent = Container
    
    local stroke = Instance.new("UIStroke", input)
    stroke.Color = Color3.fromRGB(40, 40, 50)
    stroke.Thickness = 1
    
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 6)
    return input
end

-- ================= BUILD UI ELEMENTS =================

-- SECTION: TARGET SELECTOR
createSectionTitle("Target Selector")

local PlayerDrop = createButton("Select Player: [None]", Color3.fromRGB(35, 35, 45))
local DropFrame = Instance.new("Frame")
DropFrame.Size = UDim2.new(1, 0, 0, 100)
DropFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
DropFrame.Visible = false
DropFrame.Parent = Container
Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)

local ScrollDrop = Instance.new("ScrollingFrame", DropFrame)
ScrollDrop.Size = UDim2.new(1, -6, 1, -6)
ScrollDrop.Position = UDim2.new(0, 3, 0, 3)
ScrollDrop.BackgroundTransparency = 1
ScrollDrop.ScrollBarThickness = 2
local DropLayout = Instance.new("UIListLayout", ScrollDrop)
DropLayout.Padding = UDim.new(0, 4)

local function updatePlayerList()
    for _, child in pairs(ScrollDrop:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 24)
            pBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
            pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(210, 210, 225)
            pBtn.Font = Enum.Font.Gotham
            pBtn.TextSize = 11
            pBtn.Parent = ScrollDrop
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            
            pBtn.MouseButton1Click:Connect(function()
                targetPlayer = p
                PlayerDrop.Text = "Target: " .. p.DisplayName
                DropFrame.Visible = false
            end)
        end
    end
    ScrollDrop.CanvasSize = UDim2.new(0, 0, 0, DropLayout.AbsoluteContentSize.Y)
end

PlayerDrop.MouseButton1Click:Connect(function()
    DropFrame.Visible = not DropFrame.Visible
    if DropFrame.Visible then updatePlayerList() end
end)

-- SECTION: ORBIT CONTROLS
createSectionTitle("Orbit Settings")

local OrbitToggleBtn = createButton("Orbit System: OFF", Color3.fromRGB(140, 45, 45))
local OrbitKeybindBtn = createButton("Keybind: [R]")
local OrbitSpeedInput = createInput("Orbit Speed: 20")
local OrbitDistanceInput = createInput("Orbit Distance: 8")

OrbitToggleBtn.MouseButton1Click:Connect(function()
    orbitEnabled = not orbitEnabled
    OrbitToggleBtn.Text = "Orbit System: " .. (orbitEnabled and "ACTIVE" or "OFF")
    OrbitToggleBtn.BackgroundColor3 = orbitEnabled and Color3.fromRGB(45, 140, 80) or Color3.fromRGB(140, 45, 45)
end)

OrbitKeybindBtn.MouseButton1Click:Connect(function()
    listeningKey = "orbit"
    OrbitKeybindBtn.Text = "Press Any Key..."
end)

OrbitSpeedInput.FocusLost:Connect(function()
    local val = tonumber(OrbitSpeedInput.Text:match("%d+"))
    if val then
        orbitSpeed = val
        OrbitSpeedInput.Text = "Orbit Speed: " .. tostring(val)
    end
end)

OrbitDistanceInput.FocusLost:Connect(function()
    local val = tonumber(OrbitDistanceInput.Text:match("%d+"))
    if val then
        orbitDistance = val
        OrbitDistanceInput.Text = "Orbit Distance: " .. tostring(val)
    end
end)

-- SECTION: FLY CONTROLS
createSectionTitle("Fly Settings")

local FlyToggleBtn = createButton("Fly System: OFF", Color3.fromRGB(140, 45, 45))
local FlyKeybindBtn = createButton("Keybind: [F]")
