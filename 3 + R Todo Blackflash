-- Listener Input Keybind Manual
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if isListeningForLockKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            lockTargetKeybind = input.KeyCode
            setLockKeyBtn.Text = "Lock Keybind: [ " .. input.KeyCode.Name .. " ]"
            setLockKeyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            isListeningForLockKey = false
        end
    elseif isListeningForResetKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            resetKeybind = input.KeyCode
            setResetKeyBtn.Text = "Reset Key: [ " .. input.KeyCode.Name .. " ]"
            setResetKeyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            isListeningForResetKey = false
        end
    elseif input.KeyCode == lockTargetKeybind then
        -- Toggle Lock/Unlock Target
        if lockedPlayer then
            lockedPlayer = nil -- UNLOCK Target
        else
            if hoveredPlayer then
                lockedPlayer = hoveredPlayer -- LOCK Player yang sedang dilihat
            end
        end
        updatePlayerList()

    elseif input.KeyCode == Enum.KeyCode.Three then
        -- Catat waktu tekan Skill 3
        lastSkill3Time = tick()

    elseif input.KeyCode == Enum.KeyCode.R then
        -- Jika tekan R dalam jeda 2 detik setelah Skill 3
        if autoLockSkillEnabled and (tick() - lastSkill3Time <= 2.0) then
            local targetToAccel = lockedPlayer or hoveredPlayer
            if targetToAccel and targetToAccel.Character then
                local myRoot = Character and Character:FindFirstChild("HumanoidRootPart")
                local tRoot = targetToAccel.Character:FindFirstChild("HumanoidRootPart") or targetToAccel.Character:FindFirstChild("Torso")

                if myRoot and tRoot then
                    local distance = (myRoot.Position - tRoot.Position).Magnitude
                    
                    -- Jika jarak ke target yang dikunci/dilihat lebih dari MIN_ACCEL_DISTANCE (70 Studs)
                    if distance >= MIN_ACCEL_DISTANCE then
                        accelerateToTarget(tRoot, ACCEL_DURATION)
                    end
                end
            end
        end

    elseif input.KeyCode == resetKeybind then
        -- Reset Counter Studs
        totalStudsTraveled = 0
        studLabel.Text = "Traveled: 0 Studs"
    end
end)

-- Inisialisasi awal
updatePlayerList()
