-- Function Akselerasi Mulus ke Target (Tweening)
local function accelerateToTarget(targetPart, duration)
    Character = LocalPlayer.Character
    local myRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetPart then return end

    local targetCFrame = targetPart.CFrame * CFrame.new(0, 0, 1.5)
    local tweenInfo = TweenInfo.new(
        duration, 
        Enum.EasingStyle.Quad, 
        Enum.EasingDirection.Out
    )
    
    local tween = TweenService:Create(myRoot, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
end

-- Render Loop: Sight Tracking & Visual Highlight Line
RunService.RenderStepped:Connect(function(dt)
    Character = LocalPlayer.Character
    if Character and Character:FindFirstChild("HumanoidRootPart") then
        local currentPos = Character.HumanoidRootPart.Position
        if lastPosition then
            local dist = (currentPos - lastPosition).Magnitude
            if dist > 0.05 and dist < 250 then
                totalStudsTraveled = totalStudsTraveled + dist
                studLabel.Text = string.format("Traveled: %.1f Studs", totalStudsTraveled)
            end
        end
        lastPosition = currentPos
    end

    -- Update Player yang sedang dilihat kamera jika belum di-Lock
    hoveredPlayer = getPlayerInCameraSight()

    local activeTarget = lockedPlayer or hoveredPlayer

    if activeTarget and activeTarget.Character then
        local myRoot = Character and Character:FindFirstChild("HumanoidRootPart")
        local tRoot = activeTarget.Character:FindFirstChild("HumanoidRootPart") or activeTarget.Character:FindFirstChild("Torso")

        if myRoot and tRoot then
            beamAttachment0.Parent = myRoot
            beamAttachment1.Parent = tRoot
            targetBeam.Attachment0 = beamAttachment0
            targetBeam.Attachment1 = beamAttachment1
            targetBeam.Enabled = true

            targetHighlight.Adornee = activeTarget.Character
            targetHighlight.Enabled = true

            local dist = math.floor((myRoot.Position - tRoot.Position).Magnitude)

            if lockedPlayer then
                -- Merah = Target dikunci (Lock)
                targetHighlight.FillColor = Color3.fromRGB(255, 0, 0)
                targetBeam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
                targetStatusLabel.Text = "LOCKED: " .. activeTarget.DisplayName .. " (" .. dist .. "s)"
                targetStatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            else
                -- Kuning = Target sedang dilihat (Hover)
                targetHighlight.FillColor = Color3.fromRGB(255, 255, 0)
                targetBeam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 0))
                targetStatusLabel.Text = "Aiming: " .. activeTarget.DisplayName .. " (" .. dist .. "s)"
                targetStatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
            end
        else
            targetBeam.Enabled = false
            targetHighlight.Enabled = false
        end
    else
        targetBeam.Enabled = false
        targetHighlight.Enabled = false
        targetStatusLabel.Text = "Status: Look at target..."
        targetStatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

