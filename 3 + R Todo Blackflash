-- System Deteksi Player yang Dilihat Kamera (Raycast & Camera Direction)
local function getPlayerInCameraSight()
    local bestTarget = nil
    local maxDot = 0.85 -- Batas toleransi sudut pandang (Makin mendekati 1, makin akurat di tengah layar)

    local camCFrame = Camera.CFrame
    local camLook = camCFrame.LookVector

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tRoot = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Torso")
            local tHum = plr.Character:FindFirstChildOfClass("Humanoid")

            if tRoot and tHum and tHum.Health > 0 then
                local dirToTarget = (tRoot.Position - camCFrame.Position).Unit
                local dotProduct = camLook:Dot(dirToTarget)

                if dotProduct > maxDot then
                    maxDot = dotProduct
                    bestTarget = plr
                end
            end
        end
    end

    return bestTarget
end

-- Update Realtime Player List GUI
local function updatePlayerList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -5, 0, 22)
            btn.BackgroundColor3 = (lockedPlayer == plr) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(35, 35, 35)
            btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.SourceSans
            btn.TextSize = 11
            btn.Parent = scrollFrame

            btn.MouseButton1Click:Connect(function()
                if lockedPlayer == plr then
                    lockedPlayer = nil
                else
                    lockedPlayer = plr
                end
                updatePlayerList()
            end)
        end
    end
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(function(plr)
    if lockedPlayer == plr then lockedPlayer = nil end
    updatePlayerList()
end)

